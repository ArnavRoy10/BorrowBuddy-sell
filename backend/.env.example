# ============================================
# BorrowBuddy — Environment Variables
# ============================================
# 1. Copy this file and rename the copy to: .env
# 2. Fill in your own values below (see comments for where to get each one)
# 3. Never commit or share your real .env file — it contains secrets
# 4. Run: npm install
# 5. Run: npm start

# ============================================
# MONGODB CONNECTION (REQUIRED)
# ============================================
# Get this from: MongoDB Atlas -> Database -> Connect -> Connect your application
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/borrowbuddy

# ============================================
# SERVER CONFIGURATION (REQUIRED)
# ============================================
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5500

# ============================================
# JWT & SESSION SECRETS (REQUIRED)
# ============================================
# Generate random strings for these, e.g. run: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Use a DIFFERENT random value for each — never reuse one secret for both.
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRE=7d
SESSION_SECRET=replace_with_a_different_long_random_string

# ============================================
# GOOGLE OAUTH (OPTIONAL - For "Sign in with Google")
# ============================================
# Leave as "dummy" if you don't want Google login.
# To enable: create credentials at https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=dummy
GOOGLE_CLIENT_SECRET=dummy
GOOGLE_CALLBACK_URL=http://localhost:5000/api/auth/google/callback

# ============================================
# RAZORPAY (REQUIRED for payments)
# ============================================
# Get test keys from: https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret

# ============================================
# CLOUDINARY (REQUIRED for image uploads)
# ============================================
# Get these from: https://console.cloudinary.com -> Settings -> Upload
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_unsigned_upload_preset

# ============================================
# EMAIL (REQUIRED for notification emails)
# ============================================
# For Gmail: use an App Password, NOT your real Gmail password.
# Create one at: https://myaccount.google.com/apppasswords
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM_NAME=BorrowBuddy

# ============================================
# TWILIO (OPTIONAL - for SMS/phone verification)
# ============================================
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+1xxxxxxxxxx
